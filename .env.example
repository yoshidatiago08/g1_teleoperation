# Copy to .env and edit. Only needed on the notebook.
# Address of the machine running the VM profile: its Tailscale IP, or its LAN IP.
TELEOP_PEER=100.x.y.z
# Port the VM's Zenoh router listens on (change only if 7447 is taken).
TELEOP_PORT=7447
# Use a synthetic camera instead of the RealSense (for testing the link).
FAKE_CAMERA=false
