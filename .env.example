# Copy to .env and edit. Only needed on the notebook.
# Address of the machine running the VM profile: its Tailscale IP, or its LAN IP.
TELEOP_PEER=100.x.y.z
# Port the VM's Zenoh router listens on (change only if 7447 is taken).
TELEOP_PORT=7447
# Use a synthetic camera instead of the RealSense (for testing the link).
FAKE_CAMERA=false
# VM side: how strongly the operator's forearm direction shapes the robot's arm posture.
# 0 = follow only the wrist position. Try 0.01 to 0.05 for the elbow to follow yours.
ELBOW_WEIGHT=0.01
# VM side: require the rest-pose calibration before tracking starts (see the README).
# Set to false to skip it and use the uncalibrated mapping.
CALIBRATE=true
# VM side: which arms to track: right,left (both), right or left.
ARMS=right,left
# VM side: track the palm orientation and finger curls (true/false). With false only the arms move.
HANDS=true
# VM side: how strongly the wrist follows your palm orientation. 0 = position only.
ORIENTATION_WEIGHT=0.01
# VM side: move the robot's waist with your torso (needs both hips in view). false = waist fixed.
WAIST=true
# VM side: how many degrees the camera looks down from level (positive = down). Keep the camera
# level if you can; if you tilt it, put the angle here so "up" stays up.
CAMERA_TILT=0
