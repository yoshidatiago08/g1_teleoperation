# Copy to .env on both machines. Everything is optional except VM_HOST on the notebook.
VM_HOST=              # notebook: the VM's IP (Tailscale or LAN)

HAND=right            # right | left (both machines)
MODE=arm              # arm = the G1 right arm through CuRobo IK (needs the VM's GPU) | floating = a floating hand, no arm (both machines)

# --- VM (heavy) ---
VM_SOURCE=frames      # frames = the notebook's camera | synthetic = a made-up hand, no camera needed
FINGER_SCALE=1.15     # your fingers vs the robot's (dex-retargeting scaling_factor); read when the VM starts
MUJOCO_GL=egl         # osmesa = software rendering if the VM has no GPU

# --- notebook (light) ---
MOTION_SCALE=0.3      # robot hand moves this fraction of your hand's motion; set HERE (the notebook sends it to the VM).
                      # Keys + / - in the window change it live.
ROTATION_SCALE=1.0    # 1.0 = the robot hand points exactly where yours points
CAMERA=webcam         # webcam | realsense | none (with VM_SOURCE=synthetic)
DEVICE=0              # webcam index, /dev/videoN or a video file
HFOV_DEG=70.0         # webcam field of view, used to place your hand in 3D without a depth sensor
