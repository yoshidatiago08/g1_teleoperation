# Copy to .env. Everything is optional.
HAND=right            # right | left
SOURCE=webcam         # webcam | realsense | synthetic
DEVICE=0              # webcam index, /dev/videoN or a video file (inside the container)
MOTION_SCALE=0.3      # robot hand moves this fraction of your hand's motion (live: ros2 param set /dex_hand motion_scale 0.15)
ROTATION_SCALE=1.0
FINGER_SCALE=1.15     # your fingers vs the robot's (dex-retargeting scaling_factor)
HFOV_DEG=70.0         # webcam field of view, used to place your hand in 3D without a depth sensor
