Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 0.1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: Inspire hand (scaled target)
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Marker Scale: 0.15
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Frames:
        All Enabled: false
        world:
          Value: true
        operator_hand:
          Value: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Your tracked hand (scale 1)
      Topic:
        Value: /operator_skeleton
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.2
      Focal Point:
        X: 0.35
        Y: 0.0
        Z: 0.0
      Pitch: 0.5
      Yaw: 3.6
      Name: Current View
      Value: Orbit (rviz)
