# Copy to .env  (cp env.example .env). Only ROBOT_HOST is needed, and only on the operator machine.

# The machine that runs the simulator: its Tailscale IP or LAN IP.
ROBOT_HOST=100.x.y.z

# Optional
# CAMERA=realsense        # realsense | synthetic (a scripted operator, to test without a camera)
# OPERATOR=default        # your name: calibration is saved per person in profiles/
# BACKEND=mujoco          # robot host: mujoco | dds (Isaac Sim, see docs/isaac.md)
# RENDER=true             # robot host: send the simulated robot's video to the operator window
# OPERATOR_ARGS="--set perception.hands=false"   # extra settings for the operator side, see configs/default.yaml
# ROBOT_ARGS="--set ik.elbow_weight=0.5"          # extra settings for the robot host
