Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: Unitree G1
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Marker Scale: 0.3
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Frames:
        All Enabled: false
        pelvis:
          Value: true
        torso_link:
          Value: true
        right_shoulder_pitch_link:
          Value: true
        right_wrist_roll_link:
          Value: true
        wrist_target:
          Value: true
      Value: true
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: wrist_pose
      Shape: Axes
      Axes Length: 0.2
      Axes Radius: 0.02
      Topic:
        Value: /wrist_pose
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Tracking overlay
      Topic:
        Value: /tracking/debug_image_view
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: torso_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.0
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.3
      Pitch: 0.3
      Yaw: 2.2
      Name: Current View
      Value: Orbit (rviz)
